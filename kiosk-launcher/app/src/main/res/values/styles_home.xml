<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tarjeta base -->
    <style name="HomeCard">
        <item name="cardCornerRadius">@dimen/home_card_radius</item>
        <item name="cardElevation">3dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#FFFFFF</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Tarjeta pequeña (cuadrícula) -->
    <style name="HomeTile" parent="HomeCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">@dimen/home_card_margin</item>
    </style>

    <!-- Tarjeta ancha: el alto lo reparte el peso de cada tarjeta -->
    <style name="HomeWide" parent="HomeCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_margin">@dimen/home_card_margin</item>
    </style>

    <!-- Círculo de icono de la cuadrícula -->
    <style name="IconCircle">
        <item name="android:layout_width">@dimen/tile_icon</item>
        <item name="android:layout_height">@dimen/tile_icon</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:padding">@dimen/tile_icon_pad</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@android:color/white</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Círculo de icono de tarjeta ancha -->
    <style name="IconCircleWide" parent="IconCircle">
        <item name="android:layout_width">@dimen/wide_icon</item>
        <item name="android:layout_height">@dimen/wide_icon</item>
        <item name="android:padding">@dimen/wide_icon_pad</item>
    </style>

    <!-- Chevron pequeño (esquina superior derecha de la cuadrícula) -->
    <style name="Chevron">
        <item name="android:layout_width">@dimen/chevron</item>
        <item name="android:layout_height">@dimen/chevron</item>
        <item name="android:layout_gravity">top|end</item>
        <item name="android:background">@drawable/bg_circle</item>
        <item name="android:padding">5dp</item>
        <item name="android:src">@drawable/ic_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Chevron grande (centrado en tarjetas anchas) -->
    <style name="ChevronBig" parent="Chevron">
        <item name="android:layout_width">@dimen/chevron_big</item>
        <item name="android:layout_height">@dimen/chevron_big</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:padding">9dp</item>
    </style>

    <!-- Textos -->
    <style name="TileTitle">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">@dimen/tile_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:lineSpacingMultiplier">0.92</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="TileSub">
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">@dimen/tile_sub</item>
        <item name="android:fontFamily">sans-serif-condensed-medium</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:lineSpacingMultiplier">0.95</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">3</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WideTitle" parent="TileTitle">
        <item name="android:textSize">@dimen/wide_title</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="WideSub" parent="TileSub">
        <item name="android:textSize">@dimen/wide_sub</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- ===== Diálogos (mismo estilo claro que el inicio) ===== -->
    <style name="DialogRoot">
        <item name="android:padding">20dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="DialogTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="DialogSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_sub</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Botón grande de color (texto blanco) -->
    <style name="BigButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <!-- Botón grande secundario (fondo claro, texto oscuro) -->
    <style name="BigButton.Light">
        <item name="android:textColor">@color/text_title</item>
        <item name="backgroundTint">@color/circle_gray</item>
    </style>

    <!-- Formulario del cuidador -->
    <style name="FormLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:background">@drawable/bg_form_field</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ShapeRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeCircle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
