<?xml version="1.0" encoding="utf-8"?>
<!-- Llamar por teléfono: contactos grandes de un toque -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        style="@style/DialogTitle"
        android:text="¿A quién quieres llamar?" />

    <TextView
        style="@style/DialogSub"
        android:text="Toca un nombre para llamar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContact1"
        style="@style/HomeWide"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="@color/tile_blue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                style="@style/IconCircleWide"
                android:backgroundTint="@color/c_blue"
                android:src="@drawable/ic_call"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvContact1Name"
                    style="@style/WideTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvContact1Phone"
                    style="@style/WideSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                style="@style/ChevronBig"
                android:backgroundTint="@color/chip_blue"
                app:tint="@color/c_blue" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContact2"
        style="@style/HomeWide"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="@color/tile_purple">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                style="@style/IconCircleWide"
                android:backgroundTint="@color/c_purple"
                android:src="@drawable/ic_call"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvContact2Name"
                    style="@style/WideTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvContact2Phone"
                    style="@style/WideSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                style="@style/ChevronBig"
                android:backgroundTint="@color/chip_purple"
                app:tint="@color/c_purple" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardContact3"
        style="@style/HomeWide"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginVertical="6dp"
        app:cardBackgroundColor="@color/tile_green">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="84dp"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                style="@style/IconCircleWide"
                android:backgroundTint="@color/c_green"
                android:src="@drawable/ic_call"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvContact3Name"
                    style="@style/WideTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvContact3Phone"
                    style="@style/WideSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                style="@style/ChevronBig"
                android:backgroundTint="@color/chip_green"
                app:tint="@color/c_green" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDialOther"
        style="@style/BigButton"
        android:layout_marginTop="12dp"
        android:text="Marcar otro número"
        app:backgroundTint="@color/c_blue" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseContacts"
        style="@style/BigButton.Light"
        android:text="Cerrar" />
</LinearLayout>
