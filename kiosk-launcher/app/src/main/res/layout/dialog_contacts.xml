<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📞 ¿A quién deseas llamar?"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Toca una tarjeta para llamar directamente"
        android:textColor="@color/text_sub"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <!-- Contact 1 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContact1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1E3A8A"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/card_background"
                android:gravity="center"
                android:text="👨"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvContact1Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hijo Mayor"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContact1Phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca para llamar"
                    android:textColor="#93C5FD"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_phone_call"
                app:tint="#60A5FA" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Contact 2 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContact2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#831843"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/card_background"
                android:gravity="center"
                android:text="👩"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvContact2Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hija"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContact2Phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca para llamar"
                    android:textColor="#F472B6"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_phone_call"
                app:tint="#F472B6" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Contact 3: Cuidador -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContact3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#065F46"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/card_background"
                android:gravity="center"
                android:text="🩺"
                android:textSize="26sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvContact3Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuidador / Enfermero"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContact3Phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Toca para llamar"
                    android:textColor="#6EE7B7"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_phone_call"
                app:tint="#6EE7B7" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCloseContacts"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Cerrar"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/btn_settings" />

</LinearLayout>
