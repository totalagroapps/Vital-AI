<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio (interfaz para personas mayores) - MIVOR Salud
     Cero scroll: todos los bloques reparten la altura de la pantalla con layout_weight
     y el botón de voz escala con el espacio disponible (porcentajes de ConstraintLayout).
     Tamaños de texto e iconos en values/dimens_home.xml y values-w400dp/dimens_home.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/home_pad_h"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- ===== Botón de voz (escala con la altura disponible) ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2.1">

            <View
                android:id="@+id/micHaloOuter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_mic_halo_outer"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="W,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_mic_halo_inner"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="W,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.82"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/pillVoice"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/bg_mic_button"
                android:clickable="true"
                android:contentDescription="Toca para hablar"
                android:elevation="10dp"
                android:focusable="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="W,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.64"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Icono separado del botón para poder escalarlo en proporción -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:elevation="11dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mic"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="W,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_percent="0.3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@android:color/white" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-condensed"
            android:includeFontPadding="false"
            android:text="Toca para hablar"
            android:textColor="@color/text_title"
            android:textSize="@dimen/mic_text"
            android:textStyle="bold" />

        <!-- ===== Acceder a MIVOR Salud ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMivor"
            style="@style/HomeWide"
            android:layout_weight="1.3"
            android:contentDescription="Acceder a MIVOR Salud"
            app:cardBackgroundColor="@color/tile_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/wide_pad"
                android:paddingVertical="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="@dimen/mivor_logo"
                    android:layout_height="@dimen/mivor_logo"
                    android:background="@android:color/white"
                    android:importantForAccessibility="no"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_mivor_real"
                    app:shapeAppearanceOverlay="@style/ShapeCircle"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="3dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/wide_text_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/WideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceder a"
                        android:textSize="@dimen/mivor_title_1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/WideTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MIVOR "
                            android:textSize="@dimen/mivor_title_2" />

                        <TextView
                            style="@style/WideTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salud"
                            android:textColor="@color/salud_green"
                            android:textSize="@dimen/mivor_title_2" />
                    </LinearLayout>

                    <TextView
                        style="@style/WideSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu asistente de salud" />
                </LinearLayout>

                <ImageView
                    style="@style/ChevronBig"
                    android:backgroundTint="@color/chip_blue"
                    app:tint="@color/c_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Cuadrícula 2x3 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCall"
                style="@style/HomeTile"
                android:contentDescription="Llamar por teléfono"
                app:cardBackgroundColor="@color/tile_blue">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/tile_pad"
                    android:paddingTop="@dimen/tile_pad"
                    android:paddingEnd="6dp"
                    android:paddingBottom="@dimen/tile_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_blue"
                            android:src="@drawable/ic_call"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tile_text_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llamar&#10;por teléfono" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Realiza una llamada directa" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_blue"
                        app:tint="@color/c_blue" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWhatsapp"
                style="@style/HomeTile"
                android:contentDescription="Llamar por WhatsApp"
                app:cardBackgroundColor="@color/tile_green">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/tile_pad"
                    android:paddingTop="@dimen/tile_pad"
                    android:paddingEnd="6dp"
                    android:paddingBottom="@dimen/tile_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_green"
                            android:src="@drawable/ic_whatsapp"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tile_text_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llamar&#10;por WhatsApp" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contacta fácilmente por WhatsApp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_green"
                        app:tint="@color/c_green" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSos"
                style="@style/HomeTile"
                android:contentDescription="Necesito ayuda"
                app:cardBackgroundColor="@color/tile_red">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/tile_pad"
                    android:paddingTop="@dimen/tile_pad"
                    android:paddingEnd="6dp"
                    android:paddingBottom="@dimen/tile_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_red"
                            android:src="@drawable/ic_emergency_call"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tile_text_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Necesito&#10;ayuda" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llamar o enviar aviso a los servicios de emergencia" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_red"
                        app:tint="@color/c_red" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCamera"
                style="@style/HomeTile"
                android:contentDescription="Acceder a cámara"
                app:cardBackgroundColor="@color/tile_purple">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/tile_pad"
                    android:paddingTop="@dimen/tile_pad"
                    android:paddingEnd="6dp"
                    android:paddingBottom="@dimen/tile_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_purple"
                            android:src="@drawable/ic_camera"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tile_text_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Acceder&#10;a cámara" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Toma una foto de tus análisis o documentos" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_purple"
                        app:tint="@color/c_purple" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGallery"
                style="@style/HomeTile"
                android:contentDescription="Galería"
                app:cardBackgroundColor="@color/tile_orange">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/tile_pad"
                    android:paddingTop="@dimen/tile_pad"
                    android:paddingEnd="6dp"
                    android:paddingBottom="@dimen/tile_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_orange"
                            android:src="@drawable/ic_gallery"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tile_text_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Galería" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selecciona una foto o documento" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_orange"
                        app:tint="@color/c_orange" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdd"
                style="@style/HomeTile"
                android:contentDescription="Agregar otra función"
                app:cardBackgroundColor="@color/tile_gray">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/tile_pad"
                    android:paddingTop="@dimen/tile_pad"
                    android:paddingEnd="6dp"
                    android:paddingBottom="@dimen/tile_pad">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivAddIcon"
                            style="@style/IconCircle"
                            android:backgroundTint="@color/circle_gray"
                            android:src="@drawable/ic_add"
                            app:tint="@color/c_gray" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/tile_text_gap"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvAddTitle"
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agregar&#10;otra función" />

                            <TextView
                                android:id="@+id/tvAddSub"
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personaliza tu inicio con más opciones" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/circle_gray"
                        app:tint="@color/c_gray" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- ===== Ajustes ===== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSettings"
            style="@style/HomeWide"
            android:layout_weight="1"
            android:contentDescription="Acceder a ajustes"
            app:cardBackgroundColor="@color/tile_violet">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/wide_pad"
                android:paddingVertical="4dp">

                <ImageView
                    style="@style/IconCircleWide"
                    android:backgroundTint="@color/c_violet"
                    android:src="@drawable/ic_settings"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/wide_text_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/WideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceder a ajustes" />

                    <TextView
                        style="@style/WideSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configura tu aplicación" />
                </LinearLayout>

                <ImageView
                    style="@style/ChevronBig"
                    android:backgroundTint="@color/chip_violet"
                    app:tint="@color/c_violet" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Salir con clave ===== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogout"
            style="@style/HomeWide"
            android:layout_weight="1"
            android:contentDescription="Salir con clave"
            app:cardBackgroundColor="@color/tile_pink">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/wide_pad"
                android:paddingVertical="4dp">

                <ImageView
                    style="@style/IconCircleWide"
                    android:backgroundTint="@color/circle_pink"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/c_lock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/wide_text_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/WideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Salir con clave" />

                    <TextView
                        style="@style/WideSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cierra tu sesión de forma segura" />
                </LinearLayout>

                <ImageView
                    style="@style/ChevronBig"
                    android:backgroundTint="@color/chip_pink"
                    app:tint="@color/c_lock" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Dummies (referenciados desde MainActivity) -->
    <View android:id="@+id/cardFamily" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/cardMeds" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/cardAppts" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvClock" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvVoiceStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
