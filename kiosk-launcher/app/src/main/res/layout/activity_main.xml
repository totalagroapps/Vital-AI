<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio v2 (maqueta "Kiosko MIVOR – Fase 1").
     Tres paneles a pantalla completa, uno visible cada vez:
       homePanel      hora, tiempo, cita próxima, "Ahora te toca", familia, voz, Más cosas y Necesito ayuda
       morePanel      "Más cosas": seis fichas grandes y Volver al inicio
       reminderPanel  recordatorio hablado a la hora de una toma
     "Necesito ayuda" queda siempre visible abajo; si el móvil es muy bajo, lo de encima se desplaza.
     Los ajustes del cuidador se abren manteniendo pulsada la hora 5 segundos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/h_bg"
    tools:context=".MainActivity">

    <!-- ======================= INICIO ======================= -->
    <LinearLayout
        android:id="@+id/homePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/h_pad"
        android:paddingTop="10dp"
        android:paddingBottom="@dimen/h_pad">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/h_gap">

                <!-- Hora y tiempo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/tvClock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:textColor="@color/h_ink"
                        android:textSize="@dimen/h_clock"
                        android:textStyle="bold"
                        tools:text="17:45" />

                    <LinearLayout
                        android:id="@+id/weatherChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_soft_round"
                        android:backgroundTint="@color/h_sand"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="7dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/ivWeather"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_weather_sun"
                            app:tint="@color/h_sand_ink" />

                        <TextView
                            android:id="@+id/tvWeather"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:textColor="@color/h_sand_ink"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            tools:text="18° Soleado" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/h_ink"
                    android:textSize="@dimen/h_date"
                    android:textStyle="bold"
                    tools:text="Martes, 1 de octubre" />

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:textColor="@color/h_ink_sub"
                    android:textSize="@dimen/h_greeting"
                    tools:text="Buenas tardes, Rosa" />

                <!-- Cita próxima (solo si hay una en los próximos días) -->
                <LinearLayout
                    android:id="@+id/apptBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/h_gap"
                    android:background="@drawable/bg_soft_round"
                    android:backgroundTint="@color/h_accent_soft"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/h_accent_dark" />

                    <TextView
                        android:id="@+id/tvApptBanner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:textColor="@color/h_accent_dark"
                        android:textSize="@dimen/h_body"
                        tools:text="Mañana, 10:00 · Cita con la Dra. Ruiz" />
                </LinearLayout>

                <!-- Medicación: "Ahora te toca", "Hecho" o la próxima toma -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/medCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/h_gap"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/h_white"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/h_accent"
                    app:strokeWidth="3dp"
                    tools:visibility="visible">

                    <!-- Toca ahora -->
                    <LinearLayout
                        android:id="@+id/medDue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_pill"
                                app:tint="@color/h_accent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:letterSpacing="0.04"
                                android:text="AHORA TE TOCA"
                                android:textColor="@color/h_accent"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvMedName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/h_ink"
                            android:textSize="@dimen/h_med_name"
                            android:textStyle="bold"
                            tools:text="Betaloc 50 mg" />

                        <TextView
                            android:id="@+id/tvMedDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/h_ink_sub"
                            android:textSize="@dimen/h_body"
                            tools:text="Con el desayuno · 08:00" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTaken"
                            style="@style/HButton"
                            android:layout_width="match_parent"
                            android:layout_marginTop="12dp"
                            android:text="Ya me la tomé"
                            android:textColor="@color/h_white"
                            app:backgroundTint="@color/h_accent"
                            app:icon="@drawable/ic_check"
                            app:iconTint="@color/h_white" />
                    </LinearLayout>

                    <!-- Recién tomada -->
                    <LinearLayout
                        android:id="@+id/medDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/h_ok_soft"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="54dp"
                                android:layout_height="54dp"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/h_ok"
                                android:importantForAccessibility="no"
                                android:padding="12dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/h_white" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDoneTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/h_ok_dark"
                                    android:textSize="@dimen/h_med_name"
                                    android:textStyle="bold"
                                    tools:text="¡Hecho, Rosa!" />

                                <TextView
                                    android:id="@+id/tvDoneSub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/h_ok_text"
                                    android:textSize="@dimen/h_greeting"
                                    tools:text="Betaloc anotado a las 17:45" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvDoneNext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_soft_round"
                            android:padding="12dp"
                            android:textColor="@color/h_ink"
                            android:textSize="@dimen/h_body"
                            android:textStyle="bold"
                            tools:text="La siguiente: Sintrom, a las 21:00" />

                        <TextView
                            android:id="@+id/btnUndo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:minHeight="44dp"
                            android:text="Me he equivocado, deshacer"
                            android:textColor="@color/h_ok_text"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <!-- Sin toma ahora: la próxima, o "hoy ya está todo" -->
                    <LinearLayout
                        android:id="@+id/medCalm"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/ivMedCalm"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/h_accent_soft"
                            android:importantForAccessibility="no"
                            android:padding="10dp"
                            android:src="@drawable/ic_pill"
                            app:tint="@color/h_accent" />

                        <TextView
                            android:id="@+id/tvMedCalm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:textColor="@color/h_ink"
                            android:textSize="@dimen/h_body"
                            android:textStyle="bold"
                            tools:text="Próxima pastilla: Sintrom, a las 21:00" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Familia -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/h_gap"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_call"
                        app:tint="@color/h_ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Llamar a mi familia"
                        android:textColor="@color/h_ink"
                        android:textSize="@dimen/h_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/contact1"
                        style="@style/HContact"
                        android:layout_marginEnd="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/avatar1"
                                style="@style/HAvatar"
                                android:backgroundTint="@color/h_accent_pale"
                                android:textColor="@color/h_accent_dark"
                                tools:text="C" />

                            <TextView
                                android:id="@+id/name1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/h_ink"
                                android:textSize="@dimen/h_contact_name"
                                android:textStyle="bold"
                                tools:text="Carlos" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/contact2"
                        style="@style/HContact"
                        android:layout_marginHorizontal="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/avatar2"
                                style="@style/HAvatar"
                                android:backgroundTint="@color/h_peach"
                                android:textColor="@color/h_peach_ink"
                                tools:text="L" />

                            <TextView
                                android:id="@+id/name2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/h_ink"
                                android:textSize="@dimen/h_contact_name"
                                android:textStyle="bold"
                                tools:text="Lucía" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/contact3"
                        style="@style/HContact"
                        android:layout_marginStart="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingVertical="10dp">

                            <TextView
                                android:id="@+id/avatar3"
                                style="@style/HAvatar"
                                android:backgroundTint="@color/h_mint"
                                android:textColor="@color/h_ok_dark"
                                tools:text="M" />

                            <TextView
                                android:id="@+id/name3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:paddingHorizontal="4dp"
                                android:textColor="@color/h_ink"
                                android:textSize="@dimen/h_contact_name"
                                android:textStyle="bold"
                                tools:text="Marta" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Voz y Más cosas (misma altura los dos) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:layout_marginTop="@dimen/h_gap"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTalk"
                        style="@style/HButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="Hablar con MIVOR"
                        android:textColor="@color/h_accent"
                        app:icon="@drawable/ic_mic"
                        app:iconTint="@color/h_accent"
                        app:strokeColor="@color/h_accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMore"
                        style="@style/HButton.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="Más cosas"
                        android:textColor="@color/h_ink"
                        app:icon="@drawable/ic_grid"
                        app:iconTint="@color/h_ink"
                        app:strokeColor="@color/h_ink" />
                </LinearLayout>

                <!-- Estado de la voz (lo que está diciendo o escuchando) -->
                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="@color/h_ink_sub"
                    android:textSize="15sp"
                    tools:text="Escuchando… Di «Hola MIVOR» o «Ayuda»" />
            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSos"
            style="@style/HButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/h_sos"
            android:layout_marginTop="6dp"
            android:text="Necesito ayuda"
            android:textColor="@color/h_white"
            android:textSize="@dimen/h_sos_text"
            app:backgroundTint="@color/h_sos"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_alert"
            app:iconSize="34dp"
            app:iconTint="@color/h_white" />
    </LinearLayout>

    <!-- ======================= MÁS COSAS ======================= -->
    <LinearLayout
        android:id="@+id/morePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/h_bg"
        android:orientation="vertical"
        android:padding="@dimen/h_pad"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="Más cosas"
                android:textColor="@color/h_ink"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMoreClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/h_ink_sub"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="17:45" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/h_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileVideo"
                    style="@style/HTile"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Videollamada"
                    app:cardBackgroundColor="@color/h_mint">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView style="@style/HTileIcon" android:src="@drawable/ic_video" app:tint="@color/h_mint_ink" />

                        <TextView style="@style/HTileText" android:text="Videollamada" android:textColor="@color/h_mint_ink" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tilePhotos"
                    style="@style/HTile"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Mis fotos"
                    app:cardBackgroundColor="@color/h_peach">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView style="@style/HTileIcon" android:src="@drawable/ic_photo" app:tint="@color/h_peach_ink" />

                        <TextView style="@style/HTileText" android:text="Mis fotos" android:textColor="@color/h_peach_ink" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileDocPhoto"
                    style="@style/HTile"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Foto a un papel"
                    app:cardBackgroundColor="@color/h_accent_soft">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView style="@style/HTileIcon" android:src="@drawable/ic_doc_camera" app:tint="@color/h_accent_dark" />

                        <TextView style="@style/HTileText" android:text="Foto a un papel" android:textColor="@color/h_accent_dark" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileAppointments"
                    style="@style/HTile"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Mis citas"
                    app:cardBackgroundColor="@color/h_lilac">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView style="@style/HTileIcon" android:src="@drawable/ic_calendar" app:tint="@color/h_lilac_ink" />

                        <TextView style="@style/HTileText" android:text="Mis citas" android:textColor="@color/h_lilac_ink" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileMeds"
                    style="@style/HTile"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="Mis pastillas de hoy"
                    app:cardBackgroundColor="@color/h_white"
                    app:strokeColor="@color/h_border"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView style="@style/HTileIcon" android:src="@drawable/ic_pill" app:tint="@color/h_ink" />

                        <TextView style="@style/HTileText" android:text="Mis pastillas de hoy" android:textColor="@color/h_ink" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- App que elige el cuidador (por defecto, para radio o música). Pulsación larga: cambiarla -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileCustom"
                    style="@style/HTile"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/h_sand">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/ivCustomIcon"
                            style="@style/HTileIcon"
                            android:src="@drawable/ic_music"
                            app:tint="@color/h_sand_ink" />

                        <TextView
                            android:id="@+id/tvCustomTitle"
                            style="@style/HTileText"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:paddingHorizontal="6dp"
                            android:text="Radio y música"
                            android:textColor="@color/h_sand_ink" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackHome"
            style="@style/HButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/h_sos"
            android:layout_marginTop="@dimen/h_gap"
            android:text="Volver al inicio"
            android:textColor="@color/h_white"
            app:backgroundTint="@color/h_ink"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/h_white" />
    </LinearLayout>

    <!-- ======================= RECORDATORIO ======================= -->
    <LinearLayout
        android:id="@+id/reminderPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/h_accent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="@dimen/h_pad"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReminderClock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/h_white"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="21:00" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_soft_round"
                android:backgroundTint="@color/h_reminder_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_speaker"
                    app:tint="@color/h_white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Recordatorio"
                    android:textColor="@color/h_white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:background="@drawable/bg_circle"
                android:importantForAccessibility="no"
                android:padding="30dp"
                android:src="@drawable/ic_pill"
                app:tint="@color/h_accent" />

            <TextView
                android:id="@+id/tvReminderHello"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:textColor="@color/h_white"
                android:textSize="24sp"
                tools:text="Rosa, es la hora de" />

            <TextView
                android:id="@+id/tvReminderMed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/h_white"
                android:textSize="42sp"
                android:textStyle="bold"
                tools:text="Sintrom 4 mg" />

            <TextView
                android:id="@+id/tvReminderDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_soft_round"
                android:backgroundTint="@color/h_reminder_chip"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/h_white"
                android:textSize="21sp"
                tools:text="Con la cena · 21:00" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReminderTaken"
            style="@style/HButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/h_sos"
            android:text="Ya me la tomé"
            android:textColor="@color/h_accent"
            app:backgroundTint="@color/h_white"
            app:icon="@drawable/ic_check"
            app:iconTint="@color/h_accent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReminderSnooze"
            style="@style/HButton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="Recuérdamelo en 10 minutos"
            android:textColor="@color/h_white"
            android:textSize="20sp"
            app:backgroundTint="@color/h_accent"
            app:strokeColor="@color/h_white"
            app:strokeWidth="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="También puedes decir: «ya me la tomé»"
            android:textColor="@color/h_reminder_sub"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
