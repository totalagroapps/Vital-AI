<?xml version="1.0" encoding="utf-8"?>
<!-- Alerta SOS con cuenta atrás: llama sola al terminar, salvo que se cancele -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/c_red"
        android:importantForAccessibility="no"
        android:padding="20dp"
        android:src="@drawable/ic_emergency_call"
        app:tint="@android:color/white" />

    <TextView
        style="@style/DialogTitle"
        android:layout_marginTop="12dp"
        android:text="Llamando a emergencias" />

    <TextView
        android:id="@+id/tvSosCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:includeFontPadding="false"
        android:textColor="@color/c_red"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSosDetail"
        style="@style/DialogSub"
        android:textColor="@color/text_title" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSosCallNow"
        style="@style/BigButton"
        android:layout_height="76dp"
        android:text="Llamar ya"
        android:textSize="24sp"
        android:textStyle="bold"
        app:backgroundTint="@color/c_red" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSosCancel"
        style="@style/BigButton.Light"
        android:layout_height="68dp"
        android:text="Cancelar, fue un error"
        android:textSize="20sp" />
</LinearLayout>
