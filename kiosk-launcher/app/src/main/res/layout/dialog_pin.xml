<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/DialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvPinTitle"
        style="@style/DialogTitle"
        android:text="Clave del cuidador" />

    <TextView
        android:id="@+id/tvPinHint"
        style="@style/DialogSub"
        android:text="Escribe la clave para continuar" />

    <EditText
        android:id="@+id/etPin"
        style="@style/FormField"
        android:gravity="center"
        android:hint="••••"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.4"
        android:maxLength="8"
        android:minHeight="64dp"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPin"
            style="@style/BigButton.Light"
            android:layout_width="0dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitPin"
            style="@style/BigButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Entrar"
            app:backgroundTint="@color/c_blue" />
    </LinearLayout>
</LinearLayout>
