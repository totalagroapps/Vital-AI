<?xml version="1.0" encoding="utf-8"?>
<!-- Panel del cuidador (se abre tras escribir la clave) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        style="@style/DialogRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            style="@style/DialogTitle"
            android:text="Panel del cuidador" />

        <TextView
            style="@style/DialogSub"
            android:text="Configura el teléfono de la persona mayor" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingContacts"
            style="@style/BigButton"
            android:text="Contactos, país y emergencias"
            app:backgroundTint="@color/c_blue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingSosAuto"
            style="@style/BigButton"
            android:text="Aviso SOS automático"
            app:backgroundTint="@color/c_green" />

        <!-- Solo visible si faltan permisos para el aviso de emergencia a pantalla completa -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingSosAlert"
            style="@style/BigButton"
            android:text="Permitir aviso de emergencia"
            android:visibility="gone"
            app:backgroundTint="@color/c_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingPin"
            style="@style/BigButton"
            android:text="Cambiar clave"
            app:backgroundTint="@color/c_violet" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingWifi"
            style="@style/BigButton"
            android:text="Wi-Fi e internet"
            app:backgroundTint="#0369A1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingVolume"
            style="@style/BigButton"
            android:text="Sonido y volumen"
            app:backgroundTint="#4338CA" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettingExitKiosk"
            style="@style/BigButton"
            android:text="Salir del modo kiosko"
            app:backgroundTint="@color/c_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseSettings"
            style="@style/BigButton.Light"
            android:layout_marginTop="12dp"
            android:text="Cerrar" />
    </LinearLayout>
</ScrollView>
