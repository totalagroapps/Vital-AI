<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🛠️ Panel del Cuidador"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Administración y configuración del sistema"
        android:textColor="@color/text_sub"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp" />

    <Button
        android:id="@+id/btnSettingWifi"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📶 Configurar Wi-Fi y Conexión"
        android:textColor="@color/text_white"
        android:backgroundTint="#0369A1"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnSettingVolume"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔊 Ajustes de Sonido y Brillo"
        android:textColor="@color/text_white"
        android:backgroundTint="#4338CA"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btnSettingExitKiosk"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔓 Salir del Modo Kiosko (Android Libre)"
        android:textColor="@color/text_white"
        android:backgroundTint="#B91C1C"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCloseSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Cerrar Ajustes"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/btn_settings" />

</LinearLayout>
