<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_card">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🖼️ Álbum de la Familia"
        android:textColor="@color/text_white"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvPhotoTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reunión Familiar de Domingo"
        android:textColor="@color/text_gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="6dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#0F172A">

            <TextView
                android:id="@+id/tvPhotoEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👨‍👩‍👧‍👦"
                android:textSize="72sp" />

            <TextView
                android:id="@+id/tvPhotoDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Toda la familia junta en el cumpleaños!"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnPrevPhoto"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="◀ Anterior"
            android:textColor="@color/text_white"
            android:backgroundTint="#047857"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnNextPhoto"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Siguiente ▶"
            android:textColor="@color/text_white"
            android:backgroundTint="#047857"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnClosePhotos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Volver al Inicio"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/btn_settings" />

</LinearLayout>
