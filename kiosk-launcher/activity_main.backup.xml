<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio (interfaz para personas mayores) - MIVOR Salud
     Requiere: com.google.android.material:material (incluida por defecto en proyectos nuevos)
     y un tema Theme.Material3.* o Theme.MaterialComponents.* -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <!-- ===== Botón de voz ===== -->
        <FrameLayout
            android:layout_width="160dp"
            android:layout_height="0dp"
            android:layout_weight="1.2"
            android:layout_gravity="center_horizontal">

            <View
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_halo_outer" />

            <View
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_halo_inner" />

            <FrameLayout
                android:id="@+id/pillVoice"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_mic_button"
                android:clickable="true"
                android:contentDescription="Toca para hablar"
                android:elevation="10dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic"
                    app:tint="@android:color/white" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-condensed"
            android:text="Toca para hablar"
            android:textColor="@color/text_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ===== Acceder a MIVOR Salud ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMivor"
            style="@style/HomeWide"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="Acceder a MIVOR Salud"
            app:cardBackgroundColor="@color/tile_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- Sustituye @drawable/logo_mivor_real por tu logo: res/drawable/logo_mivor.png -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@android:color/white"
                    android:importantForAccessibility="no"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_mivor_real"
                    app:shapeAppearanceOverlay="@style/ShapeCircle"
                    app:strokeColor="@android:color/white"
                    app:strokeWidth="3dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/WideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceder a"
                        android:textSize="20sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/WideTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MIVOR "
                            android:textSize="22sp" />

                        <TextView
                            style="@style/WideTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salud"
                            android:textColor="@color/salud_green"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/WideSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tu asistente de salud" />
                </LinearLayout>

                <ImageView
                    style="@style/Chevron"
                    android:backgroundTint="@color/chip_blue"
                    app:tint="@color/c_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Cuadrícula 2x3 ===== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCall"
                style="@style/HomeTile"
                android:contentDescription="Llamar por teléfono"
                app:cardBackgroundColor="@color/tile_blue">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_blue"
                            android:src="@drawable/ic_call"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="18dp">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llamar&#10;por teléfono" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Realiza una llamada directa" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_blue"
                        app:tint="@color/c_blue" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWhatsapp"
                style="@style/HomeTile"
                android:contentDescription="Llamar por WhatsApp"
                app:cardBackgroundColor="@color/tile_green">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_green"
                            android:src="@drawable/ic_whatsapp"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="18dp">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llamar&#10;por WhatsApp" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Contacta fácilmente por WhatsApp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_green"
                        app:tint="@color/c_green" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSos"
                style="@style/HomeTile"
                android:contentDescription="Necesito ayuda"
                app:cardBackgroundColor="@color/tile_red">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_red"
                            android:src="@drawable/ic_emergency_call"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="18dp">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Necesito&#10;ayuda" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Llamar o enviar aviso a los servicios de emergencia" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_red"
                        app:tint="@color/c_red" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCamera"
                style="@style/HomeTile"
                android:contentDescription="Acceder a cámara"
                app:cardBackgroundColor="@color/tile_purple">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_purple"
                            android:src="@drawable/ic_camera"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="18dp">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Acceder&#10;a cámara" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Toma una foto de tus análisis o documentos" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_purple"
                        app:tint="@color/c_purple" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.35"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGallery"
                style="@style/HomeTile"
                android:contentDescription="Galería"
                app:cardBackgroundColor="@color/tile_orange">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/c_orange"
                            android:src="@drawable/ic_gallery"
                            app:tint="@android:color/white" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="18dp">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Galería" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Selecciona una foto o documento" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/chip_orange"
                        app:tint="@color/c_orange" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdd"
                style="@style/HomeTile"
                android:contentDescription="Agregar otra función"
                app:cardBackgroundColor="@color/tile_gray">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconCircle"
                            android:backgroundTint="@color/circle_gray"
                            android:src="@drawable/ic_add"
                            app:tint="@color/c_gray" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="18dp">

                            <TextView
                                style="@style/TileTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Agregar&#10;otra función" />

                            <TextView
                                style="@style/TileSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personaliza tu inicio con más opciones" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        style="@style/Chevron"
                        android:backgroundTint="@color/circle_gray"
                        app:tint="@color/c_gray" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== Ajustes ===== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSettings"
            style="@style/HomeWide"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:contentDescription="Acceder a ajustes"
            app:cardBackgroundColor="@color/tile_violet">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    style="@style/IconCircle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="18dp"
                    android:backgroundTint="@color/c_violet"
                    android:src="@drawable/ic_settings"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/WideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceder a ajustes" />

                    <TextView
                        style="@style/WideSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Configura tu aplicación" />
                </LinearLayout>

                <ImageView
                    style="@style/Chevron"
                    android:backgroundTint="@color/chip_violet"
                    app:tint="@color/c_violet" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Salir con clave ===== -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLogout"
            style="@style/HomeWide"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:contentDescription="Salir con clave"
            app:cardBackgroundColor="@color/tile_pink">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp">

                <ImageView
                    style="@style/IconCircle"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:padding="18dp"
                    android:backgroundTint="@color/circle_pink"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/c_lock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/WideTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Salir con clave" />

                    <TextView
                        style="@style/WideSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cierra tu sesión de forma segura" />
                </LinearLayout>

                <ImageView
                    style="@style/Chevron"
                    android:backgroundTint="@color/chip_pink"
                    app:tint="@color/c_lock" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Dummies -->
    <View android:id="@+id/cardFamily" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/cardMeds" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <View android:id="@+id/cardAppts" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvClock" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/tvVoiceStatus" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>

